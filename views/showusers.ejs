<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h2>ALL REGISTERED USERS</h2>

        <table>

            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Username</th>
                <th>Actions</th>
            </tr>

            <% users.forEach((user) => { %>

                <tr>

                    <td><%= user.userId %></td>
                    <td><%= user.email %></td>
                    <td><%= user.username %></td>

                    <td>

                        <a href="/user/<%= user.userId %>/edit">
                            <button>Edit</button>
                        </a>

                        <form method="POST"
                              action="/user/<%= user.userId %>?_method=DELETE"
                              onsubmit="return confirm('Are you sure you want to delete this user?')">

                            <button type="submit">Delete</button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        </table>

        <br>

        <a href="/">← Back to Home</a>

    </div>

</body>
</html>